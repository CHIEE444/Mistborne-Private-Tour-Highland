        bigint kendaraan_id FK
        bigint hotel_id FK
    }
    penggantian_jadwal {
        bigint id PK
        bigint pesanan_id FK
    }
    pesanan_kustom {
        bigint id PK
        bigint pesanan_id FK, UK
    }
    riwayat_penawaran_pesanan_kustom {
        bigint id PK
        bigint pesanan_kustom_id FK, UK
        bigint user_id FK
        smallint versi UK
    }
    ulasan {
        bigint id PK
        bigint pesanan_id FK, UK
    }
    pertanyaan_tamu {
        bigint id PK
        bigint permintaan_pesanan_id FK
    }
    artikel {
        bigint id PK
        varchar(255) slug UK
    }
    pengaturan {
        bigint id PK
    }
    notifications {
        uuid id PK
    }
