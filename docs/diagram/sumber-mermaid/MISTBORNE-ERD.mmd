        bigint id PK
        bigint user_id FK, UK
    }
    aktivitas_personel {
        bigint id PK
        bigint personel_id FK
        bigint pesanan_id FK
    }
    permintaan_pesanan {
        bigint id PK
        varchar(80) token UK
        bigint perjalanan_id FK
        bigint pesanan_id FK, UK
        uuid token_booking UK
        bigint user_web_id FK
    }
    pesanan {
        bigint id PK
        varchar(255) kode UK
        bigint perjalanan_id FK
