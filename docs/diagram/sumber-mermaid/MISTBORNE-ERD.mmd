erDiagram
    users {
        bigint id PK
        varchar(255) email UK
    }
    perjalanan {
        bigint id PK
        varchar(255) nama UK
        varchar(255) slug UK
        bigint kendaraan_id FK
    }
    jadwal_keberangkatan {
        bigint id PK
        bigint perjalanan_id FK, UK
        date tanggal UK
    }
    hotel {
        bigint id PK
        varchar(190) slug UK
    }
    hotel_perjalanan {
        bigint id PK
        bigint hotel_id FK, UK
        bigint perjalanan_id UK, FK
    }
    kendaraan {
        bigint id PK
    }
    servis_kendaraan {
        bigint id PK
        bigint kendaraan_id FK
    }
