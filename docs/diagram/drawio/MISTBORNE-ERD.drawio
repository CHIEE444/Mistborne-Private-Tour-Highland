<mxfile host="drawio" type="device"><diagram id="mistborne" name="ERD MISTBORNE"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#F7F8F4"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s3" value="&lt;b style=&quot;font-size:26px;color:#12301F&quot;&gt;ERD (Entity Relationship Diagram) MISTBORNE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#486553&quot;&gt;19 entitas sistem dan 21 relasi foreign key. Atribut yang ditampilkan: kunci (PK, FK, UQ) dan atribut utama. Disusun dari skema PostgreSQL yang berjalan, versi final 4 November 2026.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-10" width="1100" height="70" as="geometry"/></mxCell><mxCell id="s4" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#DFE3D8;" vertex="1" parent="1"><mxGeometry x="1710" y="-40" width="760" height="150" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;Simbol kardinalitas (crow&#x27;s foot), dibaca di ujung garis:&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#14231B;" vertex="1" parent="1"><mxGeometry x="1722" y="-34" width="736" height="20" as="geometry"/></mxCell><mxCell id="s6" value="" style="endArrow=ERmandOne;endFill=0;startArrow=none;html=1;strokeColor=#486553;strokeWidth=1.6;endSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1726.0" y="6" as="sourcePoint"/><mxPoint x="1770.0" y="6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s7" value="tepat satu (wajib)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#14231B;" vertex="1" parent="1"><mxGeometry x="1778.0" y="-4" width="186.66666666666666" height="20" as="geometry"/></mxCell><mxCell id="s8" value="" style="endArrow=ERzeroToOne;en