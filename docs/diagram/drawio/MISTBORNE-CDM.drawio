<mxfile host="drawio" type="device"><diagram id="mistborne" name="CDM MISTBORNE"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#F7F8F4"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s3" value="&lt;b style=&quot;font-size:26px;color:#12301F&quot;&gt;CDM (Conceptual Data Model) MISTBORNE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#486553&quot;&gt;18 entitas konseptual dan 20 relasi. Tanpa tipe data dan tanpa kolom foreign key; relasi banyak-ke-banyak Perjalanan-Hotel digambar langsung.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-10" width="1100" height="70" as="geometry"/></mxCell><mxCell id="s4" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#DFE3D8;" vertex="1" parent="1"><mxGeometry x="1640" y="-40" width="760" height="150" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;Simbol kardinalitas (crow&#x27;s foot), dibaca di ujung garis:&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#14231B;" vertex="1" parent="1"><mxGeometry x="1652" y="-34" width="736" height="20" as="geometry"/></mxCell><mxCell id="s6" value="" style="endArrow=ERmandOne;endFill=0;startArrow=none;html=1;strokeColor=#486553;strokeWidth=1.6;endSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1656.0" y="6" as="sourcePoint"/><mxPoint x="1700.0" y="6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s7" value="tepat satu (wajib)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#14231B;" vertex="1" parent="1"><mxGeometry x="1708.0" y="-4" width="186.66666666666666" height="20" as="geometry"/></mxCell><mxCell id="s8" value="" style="endArrow=ERzeroToOne;endFill=0;startArrow=none;html=1;strokeColor=#486